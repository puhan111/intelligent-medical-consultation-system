# 环境配置
# 开发环境用 development，生产环境改为 production
ENV=development

# 基础配置
# PROJECT_NAME 用作 Docker 容器名前缀，必须为全小写、无空格（Docker 镜像命名要求）
PROJECT_NAME=app
API_V1_STR=/api/v1
API_PORT=8001
# 生产环境填写逗号分隔的前端来源，例如 https://patient.example.com,https://admin.example.com
CORS_ORIGINS=

# 数据库配置
# 默认对接开发环境自带的 postgres 容器（docker-compose.dev.yml），开箱即用
# 生产环境请改为外部数据库（如 AWS RDS）的地址和账号密码
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=app

# Redis 配置
# REDIS_HOST 为 docker-compose 中的服务名，默认即可
# REDIS_PASSWORD 需与容器启动时保持一致，生产环境建议修改
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password

# Celery configuration (auto-generated, no manual configuration needed)
# CELERY_BROKER_URL and CELERY_RESULT_BACKEND will be auto-generated based on Redis configuration

# HTTP 代理配置 - 生产环境建议关闭
USE_HTTP_PROXY=false
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890

# 邮件配置（用到发信功能时再填写真实账号）
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your_email@gmail.com
MAIL_FROM_NAME="FastAPI Template"
MAIL_ENCRYPTION=tls

# Brevo 配置（可选，使用 Brevo 发信服务时填写）
BREVO_API_KEY=your_brevo_api_key
BREVO_EMAIL_FROM=your_email@domain.com
BREVO_EMAIL_FROM_NAME="FastAPI Template"

# 管理员邮箱
ADMIN_EMAIL=admin@example.com

# JWT 配置
# 已提供可直接运行的默认密钥，正式部署请务必替换为一段足够长的随机字符串
SECRET_KEY=dev_secret_key_please_change_in_production_0123456789abcdef
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AWS S3 配置（用到对象存储时再填写真实凭证）
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=your_bucket_name
AWS_ENDPOINT=https://s3.amazonaws.com

# AI 配置（RAG / Agent 用，填写真实 Key 后才能调用 DashScope / DeepSeek）
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_RERANK_MODEL=gte-rerank-v2
# 留空时使用DashScope SDK默认地址；只有自有业务空间明确要求时才填写专属地址
DASHSCOPE_RERANK_BASE_URL=
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_TIMEOUT_SECONDS=30

# 仅运行 scripts/init_data.py 时使用；请自行设置，不要提交真实密码
DEMO_SUPERADMIN_PASSWORD=replace_with_strong_password
DEMO_PHARMACIST_PASSWORD=replace_with_strong_password
DEMO_CASHIER_PASSWORD=replace_with_strong_password
DEMO_LAB_PASSWORD=replace_with_strong_password
